# Copie para .dev.vars para rodar localmente.
# Modo de desenvolvimento: o código do SMS aparece na tela e no terminal (nenhum SMS é enviado).
OTP_DEV_MODE="true"

# Para testar com SMS de verdade localmente, remova a linha acima e preencha:
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_VERIFY_SID="VA..."

# Entrar com Google: o Client ID também fica em wrangler.jsonc ("vars").
# Para testar localmente, autorize http://localhost:8787 como origem no Google Cloud.
# GOOGLE_CLIENT_ID="1234567890-abc.apps.googleusercontent.com"
